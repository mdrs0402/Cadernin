# Config do app Web do Firebase. NÃO são segredos (vão para o navegador de qualquer forma):
# a segurança vem das firestore.rules.
# Onde pegar: Console do Firebase > ⚙ Configurações do projeto > Geral > "Seus apps" > app Web (</>).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_APP_ID=

# --- Emuladores (só desenvolvimento; NUNCA defina estas na Vercel) ---
# true = Firestore no emulador (127.0.0.1:8080), dados locais. false = Firestore real.
VITE_USE_FIRESTORE_EMULATOR=true
# true = login falso do emulador (127.0.0.1:9099). false = login Google real.
VITE_USE_AUTH_EMULATOR=false
