# URL da API (apps/api)
VITE_API_URL=http://localhost:3333

# true = login falso do emulador (127.0.0.1:9099). false = login Google real.
VITE_USE_AUTH_EMULATOR=false

# Config do app Web do Firebase. NÃO são segredos (vão para o navegador de qualquer forma);
# a segurança vem do token verificado na API e das firestore.rules.
# Onde pegar: Console do Firebase > ⚙ Configurações do projeto > Geral >
# "Seus apps" > app Web (</>) > "Configuração do SDK" > Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_APP_ID=
