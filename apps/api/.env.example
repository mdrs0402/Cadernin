# Porta da API
PORT=3333

# Origem do front liberada no CORS (só essa origem pode chamar a API)
WEB_ORIGIN=http://localhost:5173

# ID do projeto Firebase.
# Console do Firebase > ⚙ Configurações do projeto > Geral > "Código do projeto".
# (Use demo-cadernin para rodar 100% offline com o emulador de Auth.)
FIREBASE_PROJECT_ID=seu-projeto-id

# --- Emuladores (desenvolvimento) ---
# Definida = o Admin SDK usa o emulador daquele serviço. Comente para usar o Firebase real.
# Padrão de desenvolvimento: login Google REAL + Firestore no emulador (dados locais).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Service account do Admin SDK ---
# Necessária para gravar custom claims (perfil) e para o Firestore real.
# Console do Firebase > ⚙ Configurações do projeto > Contas de serviço >
# "Gerar nova chave privada". Salve FORA do repositório (ou como
# apps/api/service-account.json, que está no .gitignore) e aponte aqui.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
